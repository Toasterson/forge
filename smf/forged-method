#
# SMF method script for the forged service.
#

. /lib/svc/share/smf_include.sh

FORGED_BIN="/opt/forge/bin/forged"
DEFAULT_CONFIG="/etc/forged/forged.toml"
FAIL_COUNT_FILE="/var/lib/forged/.restart_count"
MAX_RESTARTS=3

# Read an SMF property value. Returns empty string if not set.
getprop() {
    val=$(svcprop -p "application/$1" "$SMF_FMRI" 2>/dev/null)
    # svcprop returns the literal '""' for empty astring values
    case "$val" in
        '""'|"") echo "" ;;
        *) echo "$val" ;;
    esac
}

case "$1" in
start)
    # Read config path from SMF property, fall back to default
    config=$(getprop config_file)
    if [ -z "$config" ]; then
        config="$DEFAULT_CONFIG"
    fi

    if [ ! -f "$config" ]; then
        echo "Configuration file not found: $config" >&2
        exit "$SMF_EXIT_ERR_CONFIG"
    fi

    if [ ! -x "$FORGED_BIN" ]; then
        echo "forged binary not found or not executable: $FORGED_BIN" >&2
        exit "$SMF_EXIT_ERR_FATAL"
    fi

    # Export SMF properties as environment variables.
    # These override values from the config file (env has highest precedence).
    log_level=$(getprop log_level)
    listen_addr=$(getprop listen_addr)
    postgres_url=$(getprop postgres_url)
    seaweedfs_url=$(getprop seaweedfs_url)
    amqp_url=$(getprop amqp_url)

    # RUST_LOG controls logging verbosity
    if [ -n "$log_level" ]; then
        export RUST_LOG="$log_level"
    fi

    # FORGED__* environment variables override config file sections
    if [ -n "$listen_addr" ]; then
        export FORGED__SERVER__LISTEN_ADDR="$listen_addr"
    fi
    if [ -n "$postgres_url" ]; then
        export FORGED__POSTGRES__URL="$postgres_url"
    fi
    if [ -n "$seaweedfs_url" ]; then
        export FORGED__SEAWEEDFS__MASTER_URL="$seaweedfs_url"
    fi
    if [ -n "$amqp_url" ]; then
        export FORGED__AMQP__URL="$amqp_url"
    fi

    # Track consecutive restart failures.
    # If forged exits quickly more than MAX_RESTARTS times, go to maintenance.
    count=0
    if [ -f "$FAIL_COUNT_FILE" ]; then
        count=$(cat "$FAIL_COUNT_FILE" 2>/dev/null || echo 0)
        # If last failure was >60s ago, reset counter (transient issue resolved)
        if [ -f "${FAIL_COUNT_FILE}.ts" ]; then
            last_ts=$(cat "${FAIL_COUNT_FILE}.ts" 2>/dev/null || echo 0)
            now_ts=$(date +%s)
            elapsed=$((now_ts - last_ts))
            if [ "$elapsed" -gt 60 ]; then
                count=0
            fi
        fi
    fi

    count=$((count + 1))
    echo "$count" > "$FAIL_COUNT_FILE"
    date +%s > "${FAIL_COUNT_FILE}.ts"

    if [ "$count" -gt "$MAX_RESTARTS" ]; then
        echo "forged has failed $count consecutive times (max $MAX_RESTARTS). Entering maintenance." >&2
        echo "Fix the issue, then run: svcadm clear forge/forged" >&2
        echo "0" > "$FAIL_COUNT_FILE"
        exit "$SMF_EXIT_ERR_FATAL"
    fi

    export FORGED_CONFIG="$config"
    exec "$FORGED_BIN"
    ;;

stop)
    # Successful stop means the service was running — reset failure counter
    echo "0" > "$FAIL_COUNT_FILE" 2>/dev/null
    smf_kill_contract "$2" TERM 1 30
    ret=$?
    [ "$ret" -ne 0 ] && exit 1
    ;;

*)
    echo "Usage: $0 { start | stop }" >&2
    exit "$SMF_EXIT_ERR_FATAL"
    ;;
esac

exit "$SMF_EXIT_OK"
